# Copier en .env et remplir. Le .env est ignore par git, ne jamais le commiter.

# eToro : cles en LECTURE SEULE (scope etoro-public:trade.real:read).
# Genere depuis les reglages du compte eToro une fois celui-ci verifie.
ETORO_API_KEY=
ETORO_USER_KEY=
# demo ou real. Rester sur demo tant que la lecture n'est pas validee.
ETORO_ENVIRONMENT=demo

# Perplexity : cle API pour la veille de marche quotidienne.
PERPLEXITY_API_KEY=

# Telegram : token donne par BotFather, et l'identifiant du seul chat autorise.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Portefeuille local, utilise quand aucune cle eToro n'est fournie.
PORTFOLIO_FILE=data/portfolio.yaml
